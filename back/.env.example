# Conexão com o PostgreSQL.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
#
# Exemplo usando o PostgreSQL local (porta padrão 5432):
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/quiz_dpp?schema=public"

# Porta da API
PORT=3000

# development | production
NODE_ENV=development

# --- Rate limit (bloqueio por IP contra sobrecarga) ---
# Liga/desliga TODO o rate limit. Deixe "false" durante o teste na faculdade
# (IP compartilhado por NAT pode estourar o limite). Mude para "true" em produção.
RATE_LIMIT_ENABLED=false
# Limite global da API: nº de requisições por IP dentro da janela.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Limite estrito para criação de jogos (POST /api/games).
GAME_RATE_LIMIT_WINDOW_MS=3600000
GAME_RATE_LIMIT_MAX=20

# Confiança em reverse proxy (para o rate limit ver o IP real do cliente):
#   false = uso local/direto | true = 1 proxy | número = N saltos de proxy
TRUST_PROXY=false
