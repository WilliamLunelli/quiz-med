# URL base da API do backend.
# Deixe vazio para usar o proxy do Vite (/api -> http://localhost:3000 em dev).
# Em produção, aponte para a URL pública da API, ex: https://api.seudominio.com
VITE_API_URL=

# (Opcional) Id do jogo padrão quando a URL não traz ?game=<id>.
# Se vazio, o app busca o jogo mais recente pela API (GET /api/games).
VITE_DEFAULT_GAME_ID=
